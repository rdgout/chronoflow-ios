          "stringUnit": {
            "state": "translated",
            "value": "Accept and continue"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkoord en verder"
          }
        }
      }
    },
    "Before you continue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you continue"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voordat je verdergaat"
          }
        }
      }
    },
    "Check your connection and try again. You can keep reading the policy meanwhile.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection and try again. You can keep reading the policy meanwhile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer je verbinding en probeer het opnieuw. Je kunt de voorwaarden intussen blijven lezen."
          }
        }
      }
    },
    "ChronoFlow gives general timing guidance, not medical advice. Check with a doctor if you have a health condition, are pregnant or take prescription medicine.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ChronoFlow gives general timing guidance, not medical advice. Check with a doctor if you have a health condition, are pregnant or take prescription medicine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ChronoFlow geeft algemene timingadviezen, geen medisch advies. Overleg met een arts als je een aandoening hebt, zwanger bent of medicijnen op recept gebruikt."
          }
        }
      }
    },
    "ChronoFlow helps you plan sleep, light and caffeine around your trip.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ChronoFlow helps you plan sleep, light and caffeine around your trip."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ChronoFlow helpt je slaap, licht en cafeïne rond je reis te plannen."
          }
        }
      }
    },
    "Couldn't save your answer.": {
      "localizations": {
