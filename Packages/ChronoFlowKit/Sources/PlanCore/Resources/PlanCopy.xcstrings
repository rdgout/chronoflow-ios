    "A demanding day: if you can do only part of the plan, keep it dim from :fromUtc to :untilUtc.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A demanding day: if you can do only part of the plan, keep it dim from %1$@ to %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een drukke dag: als je maar een deel van het plan kunt doen, houd het dan gedimd van %1$@ tot %2$@."
          }
        }
      },
      "generatesSymbol": false
    },
