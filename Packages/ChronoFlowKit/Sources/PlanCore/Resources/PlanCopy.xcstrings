          }
        }
      },
      "generatesSymbol": false
    },
    "A shift of 7 hours or more earlier is a large change; the light and dim-light blocks matter most on this trip.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shift of 7 hours or more earlier is a large change; the light and dim-light blocks matter most on this trip."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een verschuiving van 7 uur of meer naar vroeger is een grote verandering; de blokken met licht en met gedimd licht tellen bij deze reis het zwaarst."
          }
        }
      },
      "generatesSymbol": false
    },
